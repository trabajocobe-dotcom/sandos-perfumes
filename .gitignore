# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# También las de las herramientas auxiliares: el generador de imágenes traía
# 4.288 archivos de node_modules al repositorio del sitio.
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# supabase temp files
supabase/.temp/

# Perfil de Chrome del generador de imágenes.
# Son decenas de miles de archivos con cookies y sesiones guardadas: no deben
# viajar al repositorio, y además hacen lentísimo cualquier comando de git.
tools/**/chrome-session/
tools/**/debug-profile/
# Capturas de depuración e imágenes generadas: son salidas, no fuente.
tools/**/debug_*.png
tools/**/output/

# logs del servidor local
server.log
server-error.log
